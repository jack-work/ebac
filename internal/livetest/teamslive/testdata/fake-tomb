#!/usr/bin/env bash
# fake tomb for the teams plugin (golden + core live tests): prints the chat the scenario names (same fixtures as
# internal/source/teams TestTombHelperProcess). Fails if the token did not arrive on fd 3.
[ "${TOMB_AAD_TOKEN_FD:-}" = 3 ] || { echo "no token fd" >&2; exit 9; }
tok=$(cat <&3); [ "$tok" = faketoken ] || { echo "bad token" >&2; exit 9; }
m1='{"id":"1","messagetype":"RichText/Html","imdisplayname":"A","content":"<p>x</p>"}'
m2='{"id":"2","messagetype":"RichText/Html","imdisplayname":"Akshay","content":"<p>please look</p>"}'
case "$FAKE_SCENARIO" in
  ok)  echo "{\"messages\":[$m1]}" ;;
  ok2) echo "{\"messages\":[$m1,$m2]}" ;;
  ok3|ok4) n=${FAKE_SCENARIO#ok}; echo "{\"messages\":[$m1,$m2,{\"id\":\"$n\",\"messagetype\":\"RichText/Html\",\"imdisplayname\":\"Akshay\",\"content\":\"<p>again $n</p>\"}]}" ;;
  edit) echo "{\"messages\":[$m1,{\"id\":\"2\",\"messagetype\":\"RichText/Html\",\"imdisplayname\":\"Akshay\",\"content\":\"<p>please look NOW</p>\"}]}" ;;
  del) echo "{\"messages\":[$m1]}" ;;
  gone404) echo "Error: chat API returned 404" >&2; exit 1 ;;
  gone403) echo "Error: chat API returned 403" >&2; exit 1 ;;
  auth403) echo 'Error: auth service returned 403: {"error":"interaction_required"}' >&2; exit 1 ;;
  down) echo "Error: dial unix /run/user/1000/tomb.sock: connect: connection refused" >&2; exit 1 ;;
  garbage) echo "not json" ;;
  *) exit 1 ;;
esac
